mes New Roman" w:eastAsia="宋体" w:hAnsi="Times New Roman" w:cs="Times New Roman" /><w:b /><w:szCs w:val="21" /></w:rPr><w:t>指导教师</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1154" w:type="dxa" /><w:vAlign w:val="center" /></w:tcPr><w:p><w:r><w:t>（未提供）</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00F70C9D" ns2:paraId="2C1736C8" ns2:textId="77777777"><w:trPr><w:trHeight w:val="567" /></w:trPr><w:tc><w:tcPr><w:tcW w:w="1637" w:type="dxa" /><w:vAlign w:val="center" /></w:tcPr><w:p ns2:paraId="6ABD35AA" ns2:textId="77777777" w:rsidR="00F70C9D" w:rsidRDefault="00F50F3C"><w:pPr><w:spacing w:line="360" w:lineRule="auto" /><w:jc w:val="center" /><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman" /><w:b /><w:szCs w:val="21" /></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman" /><w:b /><w:szCs w:val="21" /></w:rPr><w:t>学生姓名</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1235" w:type="dxa" /><w:vAlign w:val="center" /></w:tcPr><w:p><w:r><w:t>（未提供）</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1669" w:type="dxa" /><w:vAlign w:val="center" /></w:tcPr><w:p ns2:paraId="33FFED03" ns2:textId="77777777" w:rsidR="00F70C9D" w:rsidRDefault="00F50F3C"><w:pPr><w:spacing w:line="360" w:lineRule="auto" /><w:jc w:val="center" /><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman" /><w:b /><w:szCs w:val="21" /></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman" /><w:b /><w:szCs w:val="21" /></w:rPr><w:t>学号</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1547" w:type="dxa" /><w:vAlign w:val="center" /></w:tcPr><w:p><w:r><w:t>（未提供）</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1280" w:type="dxa" /><w:vAlign w:val="center" /></w:tcPr><w:p ns2:paraId="7E6E4D34" ns2:textId="77777777" w:rsidR="00F70C9D" w:rsidRDefault="00F50F3C"><w:pPr><w:spacing w:line="360" w:lineRule="auto" /><w:jc w:val="center" /><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman" /><w:b /><w:szCs w:val="21" /></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman" /><w:b /><w:szCs w:val="21" /></w:rPr><w:t>班级</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1154" w:type="dxa" /><w:vAlign w:val="center" /></w:tcPr><w:p><w:r><w:t>（未提供）</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00F70C9D" ns2:paraId="274ED476" ns2:textId="77777777"><w:trPr><w:trHeight w:val="735" /></w:trPr><w:tc><w:tcPr><w:tcW w:w="8522" w:type="dxa" /><w:gridSpan w:val="6" /></w:tcPr><w:p><w:r><w:t>研究或设计的目的和意义：针对高带宽网络环境下传统防火墙吞吐不足、时延偏高的问题，基于DPDK构建用户态高速报文处理能力，提升ACL匹配与会话跟踪的性能与稳定性。项目可服务于数据中心与校园网等场景的安全防护需求，在保障业务连续性的同时降低安全策略生效时延，具备明显的应用价值与推广意义。</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00F70C9D" w:rsidRPr="007D7EAE" ns2:paraId="3874142E" ns2:textId="77777777"><w:trPr><w:trHeight w:val="2595" /></w:trPr><w:tc><w:tcPr><w:tcW w:w="8522" w:type="dxa" /><w:gridSpan w:val="6" /></w:tcPr><w:p><w:r><w:t>研究或设计发展趋势：高速网络正从10G向25G/40G/100G演进，内核态处理难以满足低时延与高吞吐需求。DPDK、XDP/eBPF、SR-IOV与可编程网卡等技术推动用户态与硬件卸载协同发展。防火墙技术呈现控制面与数据面分离、规则增量同步、分核并行处理与状态表分片管理等方向。</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00F70C9D" ns2:paraId="1DB41CD6" ns2:textId="77777777"><w:trPr><w:trHeight w:val="1570" /></w:trPr><w:tc><w:tcPr><w:tcW w:w="8522" w:type="dxa" /><w:gridSpan w:val="6" /></w:tcPr><w:p><w:r><w:t>主要研究或设计内容，需要解决的关键问题和思路：构建控制面、Web后端与DPDK数据面协同架构；设计ACL规则模型与增量同步机制；实现有状态会话表、分核分片与过期回收；优化ACL匹配路径和锁粒度以降低延迟。关键问题包括规则一致性、并发访问开销、内存占用与性能评估，拟通过前缀对比增量更新、每核会话表、批处理与亲和性优化等方式解决。</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00F70C9D" ns2:paraId="733D5CA9" ns2:textId="77777777"><w:trPr><w:trHeight w:val="90" /></w:trPr><w:tc><w:tcPr><w:tcW w:w="8522" w:type="dxa" /><w:gridSpan w:val="6" /></w:tcPr><w:p><w:r><w:t>完成毕业论文（设计）所必须具备的工作条件及解决的办法：具备支持DPDK的Linux环境与万兆网卡或等效测试平台，配置多核CPU与足够内存；使用Meson/Ninja构建工具链，配合流量发生器（如pktgen或tcpreplay）进行性能测试。若缺少真实网卡条件，采用软件回环与虚拟化环境进行功能验证，并以模拟流量完成实验数据采集。</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00F70C9D" ns2:paraId="326E1AB9" ns2:textId="77777777"><w:trPr><w:trHeight w:val="90" /></w:trPr><w:tc><w:tcPr><w:tcW w:w="8522" w:type="dxa" /><w:gridSpan w:val="6" /><w:tcBorders><w:bottom w:val="single" w:sz="4" w:space="0" w:color="auto" /></w:tcBorders></w:tcPr><w:p><w:r><w:t>五、工作的主要阶段、进度与时间安排：</w:t></w:r></w:p><w:p><w:r><w:t>第1-2周：需求分析与文献调研，明确研究目标与技术路线；</w:t></w:r></w:p><w:p><w:r><w:t>第3-4周：搭建开发环境，熟悉DPDK与现有代码结构；</w:t></w:r></w:p><w:p><w:r><w:t>第5-6周：设计ACL与会话表结构，完善控制面接口；</w:t></w:r></w:p><w:p><w:r><w:t>第7-8周：实现数据面ACL匹配与会话跟踪功能；</w:t></w:r></w:p><w:p><w:r><w:t>第9-10周：实现增量同步、并发优化与分核会话表；</w:t></w:r></w:p><w:p><w:r><w:t>第11-12周：联调测试与性能评估，修复问题；</w:t></w:r></w:p><w:p><w:r><w:t>第13周：论文初稿与实验结果整理；</w:t></w:r></w:p><w:p><w:r><w:t>第14周：论文定稿与答辩准备。</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00F70C9D" ns2:paraId="7F7F114F" ns2:textId="77777777"><w:trPr><w:trHeight w:val="3827" /></w:trPr><w:tc><w:tcPr><w:tcW w:w="8522" w:type="dxa" /><w:gridSpan w:val="6" /></w:tcPr><w:p><w:r><w:t>阅读的主要参考文献及资料名称：</w:t></w:r></w:p><w:p><w:r><w:t>[1] Intel. Data Plane Development Kit (DPDK) Programmer’s Guide, 2024.</w:t></w:r></w:p><w:p><w:r><w:t>[2] Postel J. Internet Protocol, RFC 791, IETF, 1981.</w:t></w:r></w:p><w:p><w:r><w:t>[3] Postel J. Transmission Control Protocol, RFC 793, IETF, 1981.</w:t></w:r></w:p><w:p><w:r><w:t>[4] Postel J. User Datagram Protocol, RFC 768, IETF, 1980.</w:t></w:r></w:p><w:p><w:r><w:t>[5] 刘某某, 李某某. DPDK高性能报文处理技术研究. 计算机工程与应用, 2022.</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00F70C9D" ns2:paraId="267F1CA8" ns2:textId="77777777"><w:trPr><w:trHeight w:val="4162" /></w:trPr><w:tc><w:tcPr><w:tcW w:w="8522" w:type="dxa" /><w:gridSpan w:val="6" /></w:tcPr><w:p ns2:paraId="48C7ED33" ns2:textId="77777777" w:rsidR="00F70C9D" w:rsidRDefault="00F50F3C"><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="3" /></w:numPr><w:spacing w:line="360" w:lineRule="auto" /><w:rPr><w:rFonts w:ascii="Times New Roman" w:h